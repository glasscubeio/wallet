# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=9550

# Local: mongodb://127.0.0.1:27017/hamyon
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/hamyon
MONGODB_URI=mongodb://127.0.0.1:27017/hamyon

# ---------------------------------------------------------------------------
# Auth — generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-32-bytes-of-random-hex
JWT_REFRESH_SECRET=replace-me-with-a-different-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Comma-separated list of allowed browser origins.
# Local: http://localhost:9551
# Prod:  https://wallet.glasscube.uz
WEB_ORIGIN=http://localhost:9551

# Production only — lets the cookie work across wa.* and wallet.*
# COOKIE_DOMAIN=.glasscube.uz

# ---------------------------------------------------------------------------
# Coinbase Developer Platform — https://portal.cdp.coinbase.com
#
# Used ONLY to hold each user's key and produce EIP-712 signatures server-side.
# The user never sees Coinbase: no widget, no CDP login, no browser SDK.
#
# NOT the Project ID, and NOT the Client API Key (that one is for frontend
# SDKs and domain whitelisting — we never call CDP from the browser).
#
#   CDP_API_KEY_ID / CDP_API_KEY_SECRET  -> "Secret API Key" in the portal
#   CDP_WALLET_SECRET                    -> "Wallet Secret", generated
#                                           separately, shown once, ~120+ chars
#
# Reads work with the API key alone, so a wrong Wallet Secret looks fine until
# something tries to create a wallet or sign. The server checks its shape on
# startup and tells you if it's wrong.
# ---------------------------------------------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ---------------------------------------------------------------------------
# Gas station — OUR relayer. This is the wallet that pays everyone's gas.
#
# Fund it with Base Sepolia ETH: https://www.alchemy.com/faucets/base-sepolia
# It never holds user USDC and cannot move funds without a signed
# authorization from the user's own key.
#
# The address is DERIVED from this key — there is no separate address setting.
# Run `bun run operator` to see it, its balance, and where to top it up.
#
# Generate one with:
#   bun -e "import('viem/accounts').then(m=>{const k=m.generatePrivateKey();console.log(k, m.privateKeyToAccount(k).address)})"
# ---------------------------------------------------------------------------
OPERATOR_PRIVATE_KEY=
# Health check reports degraded below this many ETH.
OPERATOR_MIN_BALANCE_ETH=0.01

# ---------------------------------------------------------------------------
# Chain — Base Sepolia testnet
# ---------------------------------------------------------------------------
NETWORK=base-sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---------------------------------------------------------------------------
# Resend — https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be a verified domain in Resend. onboarding@resend.dev works for testing
# but only delivers to the address that owns the Resend account.
EMAIL_FROM=Hamyon <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Basescan / Etherscan V2 — https://basescan.org/myapikey
# ---------------------------------------------------------------------------
BASESCAN_API_KEY=
BASESCAN_API_URL=https://api.etherscan.io/v2/api
EXPLORER_BASE_URL=https://sepolia.basescan.org

# ---------------------------------------------------------------------------
# MoonPay — https://dashboard.moonpay.com (use sandbox keys for testnet)
# ---------------------------------------------------------------------------
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_BUY_URL=https://buy-sandbox.moonpay.com
MOONPAY_SELL_URL=https://sell-sandbox.moonpay.com
MOONPAY_CURRENCY_CODE=usdc

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Require a verified email before sign-in is allowed.
REQUIRE_EMAIL_VERIFICATION=false
# Email a 6-digit code to authorise every outgoing transfer.
REQUIRE_OTP_FOR_SEND=true
OTP_TTL_MINUTES=10
# How long a signed transfer authorization stays valid on chain, in seconds.
AUTHORIZATION_TTL_SECONDS=600
